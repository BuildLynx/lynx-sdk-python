<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Lexend', sans-serif;
            background: #FFFFFF;
            color: #000000;
            line-height: 1.6;
            max-width: 960px;
            margin: 0 auto;
            padding: 2rem 1.5rem;
        }

        h1 {
            font-weight: 500;
            font-size: 2rem;
            margin-bottom: 0.5rem;
            color: #000000;
        }

        h2 {
            font-weight: 500;
            font-size: 1.4rem;
            color: #000000;
            margin-top: 1.5rem;
            margin-bottom: 0.75rem;
        }

        h3 {
            font-weight: 300;
            font-size: 1.15rem;
            color: #FF4E00;
            margin-top: 1.25rem;
            margin-bottom: 0.5rem;
        }

        h4, h5, h6 {
            font-weight: 400;
            color: #000000;
            margin-top: 1rem;
            margin-bottom: 0.5rem;
        }

        p {
            margin-bottom: 0.75rem;
        }

        a {
            color: #FF4E00;
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }

        hr {
            border: none;
            border-top: 1px solid #E0E0E0;
            margin: 1.5rem 0;
        }

        /* Tables */
        table {
            border-collapse: collapse;
            width: 100%;
            margin-bottom: 1rem;
            font-size: 0.9rem;
        }

        thead th {
            text-align: left;
            padding: 0.5rem 0.75rem;
            border-bottom: 2px solid #FF4E00;
            font-weight: 500;
        }

        tbody td {
            padding: 0.4rem 0.75rem;
            border-bottom: 1px solid #F0F0F0;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        /* Inline code */
        code {
            font-family: 'Lexend', monospace;
            font-size: 0.85em;
            background: #F5F5F5;
            padding: 0.15em 0.4em;
            border-radius: 3px;
            border-left: 2px solid #FF4E00;
        }

        /* Code inside summary (endpoint topics) */
        summary code {
            font-weight: 500;
            font-size: 0.9em;
        }

        pre {
            background: #F5F5F5;
            border-left: 3px solid #FF4E00;
            padding: 1rem;
            overflow-x: auto;
            margin-bottom: 1rem;
            border-radius: 3px;
        }

        pre code {
            background: none;
            border-left: none;
            padding: 0;
        }

        /* Blockquotes (endpoint descriptions) */
        blockquote {
            border-left: 3px solid #FF4E00;
            padding-left: 1rem;
            color: #555;
            margin-bottom: 0.75rem;
            font-style: italic;
        }

        /* Lists (schema tree) */
        ul {
            list-style: none;
            padding-left: 1.25rem;
            margin-bottom: 0.5rem;
        }

        ul li {
            position: relative;
            padding: 0.15rem 0;
            font-weight: 300;
        }

        /* Details / collapsible sections */
        details {
            margin-bottom: 0.5rem;
        }

        details summary {
            cursor: pointer;
            padding: 0.4rem 0;
            font-weight: 400;
            user-select: none;
        }

        details summary:hover {
            color: #FF4E00;
        }

        details[open] > summary {
            margin-bottom: 0.5rem;
        }

        /* Section-level details (generated by JS for h2/h3) */
        details.section-collapse {
            border-bottom: 1px solid #F0F0F0;
            padding-bottom: 0.25rem;
        }

        details.section-collapse > summary {
            padding: 0.5rem 0;
            list-style: none;
        }

        details.section-collapse > summary::before {
            content: '▸ ';
            color: #FF4E00;
            font-size: 0.8em;
        }

        details.section-collapse[open] > summary::before {
            content: '▾ ';
        }

        details.section-collapse > summary::-webkit-details-marker {
            display: none;
        }

        /* Type labels in schema */
        strong {
            font-weight: 300;
            color: #555;
        }

        /* Hierarchy indentation for nested collapsible sections */
        details.section-collapse details.section-collapse {
            margin-left: 1.25rem;
        }

        /* Print / PDF styles */
        @media print {
            body {
                max-width: none;
                padding: 0;
            }

            details, details.section-collapse {
                display: block !important;
            }

            details > summary {
                list-style: none;
            }

            details.section-collapse > summary::before {
                content: '';
            }
        }
    </style>
</head>
<body>
    {{ body }}

    <script>
    (function() {
        var h2s = document.querySelectorAll('h2');
        var h3s = document.querySelectorAll('h3');

        function wrapSection(sec) {
            var details = document.createElement('details');
            details.className = 'section-collapse';
            var summary = document.createElement('summary');
            summary.innerHTML = sec.heading.innerHTML;
            summary.style.fontSize = window.getComputedStyle(sec.heading).fontSize;
            summary.style.fontWeight = window.getComputedStyle(sec.heading).fontWeight;
            summary.style.color = window.getComputedStyle(sec.heading).color;
            details.appendChild(summary);
            for (var j = 0; j < sec.contents.length; j++) {
                details.appendChild(sec.contents[j]);
            }
            sec.heading.parentNode.replaceChild(details, sec.heading);
        }

        // Phase 1: Wrap h3s (stop at next h2 or h3)
        var h3Sections = [];
        for (var i = 0; i < h3s.length; i++) {
            var heading = h3s[i];
            var nextBoundary = null;
            var sib = heading.nextElementSibling;
            while (sib) {
                if (/^H[23]$/.test(sib.tagName)) { nextBoundary = sib; break; }
                sib = sib.nextElementSibling;
            }
            var contents = [];
            var node = heading.nextSibling;
            while (node && node !== nextBoundary) {
                contents.push(node);
                node = node.nextSibling;
            }
            h3Sections.push({heading: heading, contents: contents});
        }
        for (var i = h3Sections.length - 1; i >= 0; i--) { wrapSection(h3Sections[i]); }

        // Phase 2: Wrap h2s (stop at next h2; h3 wrappers are now inside)
        var h2Sections = [];
        for (var i = 0; i < h2s.length; i++) {
            var heading = h2s[i];
            var nextH2 = (i + 1 < h2s.length) ? h2s[i + 1] : null;
            var contents = [];
            var node = heading.nextSibling;
            while (node && node !== nextH2) {
                contents.push(node);
                node = node.nextSibling;
            }
            h2Sections.push({heading: heading, contents: contents});
        }
        for (var i = h2Sections.length - 1; i >= 0; i--) { wrapSection(h2Sections[i]); }
    })();
    </script>
</body>
</html>
